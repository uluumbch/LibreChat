// Hermes-Chat data model (PostgreSQL). The provider key is app-level and is NOT stored here;
// `model`, `instructions`, `memoryEnabled`, `enabledToolsets` are the per-user "profile" preferences.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  email         String  @unique
  passwordHash  String? @map("password_hash")
  name          String?
  role          String  @default("USER")
  status        String  @default("ACTIVE")
  emailVerified Boolean @default(false) @map("email_verified")

  // credits (admin-managed): remaining = creditsPurchased - creditsUsed
  creditsPurchased Int @default(0) @map("credits_purchased")
  creditsUsed      Int @default(0) @map("credits_used")
  lastTopupAt      DateTime? @map("last_topup_at")
  // True once the user has bought credits beyond the starter grant (free vs paid).
  hasToppedUp      Boolean @default(false) @map("has_topped_up")

  // Service tier: "free" (shared pool) or "dedicated" (paid — higher limits + an optional
  // reserved gateway). The provider key is still app-level; see dedicatedGatewayId.
  tier               String  @default("free")
  dedicatedGatewayId String? @map("dedicated_gateway_id")

  // hermes_profile (preferences only)
  model           String?
  instructions    String?
  memoryEnabled   Boolean  @default(true) @map("memory_enabled")
  enabledToolsets String[] @default([]) @map("enabled_toolsets")
  enabledSkills   String[] @default([]) @map("enabled_skills")

  // Composio third-party apps (gateway-bridged connected accounts).
  composioEnabled  Boolean  @default(false) @map("composio_enabled")
  composioToolkits String[] @default([])    @map("composio_toolkits")

  // Curated slash commands the user may use. RESTRICT-ONLY like enabledSkills:
  // empty = inherit all globally-enabled commands; non-empty = allowlist (by name).
  enabledCommands  String[] @default([])    @map("enabled_commands")

  // First-party LLM models the user is granted (by LlmModel.slug). Empty = only the built-in
  // pool model. A non-empty allowlist; the user may select any granted (and globally-enabled) model.
  allowedModels    String[] @default([])    @map("allowed_models")

  refreshTokens RefreshToken[]
  conversations Conversation[]
  messages      Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Conversation {
  id              String  @id @default(uuid()) @db.Uuid
  title           String  @default("New Chat")
  userId          String  @map("user_id") @db.Uuid
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hermesSessionId String? @map("hermes_session_id")
  hermesGatewayId String? @map("hermes_gateway_id")
  model           String?

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt(sort: Desc), id])
  @@map("conversations")
}

model Message {
  id             String  @id @default(uuid()) @db.Uuid
  conversationId String  @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String  @map("user_id") @db.Uuid
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  role            String
  text            String  @default("")
  // MessageContentPart[] (discriminated union) stored as jsonb
  content         Json
  parentMessageId String? @map("parent_message_id")
  finishReason    String? @map("finish_reason")
  error           Boolean @default(false)

  // Per-turn usage, metered onto the assistant message (null for user turns / un-metered rows).
  inputTokens    Int? @map("input_tokens")
  outputTokens   Int? @map("output_tokens")
  totalTokens    Int? @map("total_tokens")
  creditsCharged Int? @map("credits_charged")
  // Model slug effective for this turn (LlmModel.slug; null = built-in pool / pre-feature rows).
  // Used to attribute usage per model for analytics — left-joined to LlmModel at report time.
  model          String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([role, createdAt])
  @@map("messages")
}

// A Composio toolkit the admin has enabled product-wide. Presence of a row = enabled;
// it becomes grantable per user via User.composioToolkits. `name` is cached for display.
model ComposioToolkit {
  slug      String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("composio_toolkits")
}

// A first-party LLM provider the admin has registered. The API key is encrypted at rest
// (`apiKeyEnc`, AES-256-GCM) and never returned to the client. `kind` selects the upstream
// protocol the gateway uses: gemini | openai | anthropic | openai-compatible (needs baseUrl).
model LlmProvider {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  kind      String
  baseUrl   String?    @map("base_url")
  apiKeyEnc String     @map("api_key_enc")
  enabled   Boolean    @default(true)
  models    LlmModel[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("llm_providers")
}

// A model offered by a provider. `slug` is the user-facing id (unique across providers, what the
// user picks); `modelId` is the upstream id sent to the gateway. Globally grantable when enabled.
model LlmModel {
  slug       String      @id
  providerId String      @map("provider_id") @db.Uuid
  provider   LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId    String      @map("model_id")
  label      String
  enabled    Boolean     @default(true)
  // Admin-set USD price per 1,000,000 tokens (input / output). Null = unpriced (no USD shown).
  inputUsdPerMTok  Decimal? @map("input_usd_per_mtok")  @db.Decimal(12, 6)
  outputUsdPerMTok Decimal? @map("output_usd_per_mtok") @db.Decimal(12, 6)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([providerId])
  @@map("llm_models")
}

// A curated slash command the admin defines product-wide. Three kinds (see `type`):
//   prompt        — expands `promptTemplate` ({{args}} placeholder) into the turn message.
//   skill_scope   — overrides allowed toolsets/skills for the turn + optional promptPrefix.
//   server_action — server returns a fixed/queried reply (no LLM), keyed by `actionKey`.
// Globally enabled commands are available to all users; per-user allowlist via User.enabledCommands.
model SlashCommand {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique // trigger token, no leading slash, lowercase: "summarize"
  description    String
  type           String // "prompt" | "skill_scope" | "server_action"
  enabled        Boolean  @default(true) @map("enabled")
  promptTemplate String?  @map("prompt_template")
  scopeToolsets  String[] @default([]) @map("scope_toolsets")
  scopeSkills    String[] @default([]) @map("scope_skills")
  promptPrefix   String?  @map("prompt_prefix")
  actionKey      String?  @map("action_key")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("slash_commands")
}
