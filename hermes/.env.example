# ---- Hermes-Chat: docker compose environment ----
# `docker compose` reads this file (as hermes/.env) to fill the values below.
#   cp .env.example .env   then set your keys.
#
# (The BFF's own runtime config is set inside docker-compose.yml. For running the
#  BFF WITHOUT docker, see server/.env.example instead.)

# OpenRouter API key — the Hermes agent uses this to call the LLM.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shared bearer secret between the BFF and the Hermes api_server. Use any strong
# random string; the same value gates the gateway (API_SERVER_KEY) and is sent by the BFF.
HERMES_API_KEY=change-me-local-dev

# Optional: the OpenRouter model id the agent should use.
# Leave empty to use the image's seeded default (anthropic/claude-opus-4.6 via OpenRouter).
# Examples: nousresearch/hermes-4-405b · anthropic/claude-opus-4.6 · openai/gpt-4o
HERMES_MODEL=
