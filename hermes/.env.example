# ---- Hermes-Chat: docker compose environment ----
# `docker compose` reads this file (as hermes/.env) to fill the values below.
#   cp .env.example .env   then set your keys.
#
# (The BFF's own runtime config is set inside docker-compose.yml. For running the
#  BFF WITHOUT docker, see server/.env.example instead.)

# Shared bearer secret between the BFF and the Hermes api_server. Use any strong
# random string; the same value gates the gateway (API_SERVER_KEY) and is sent by the BFF.
HERMES_API_KEY=change-me-local-dev

# ---- LLM provider ----
# Set AT LEAST ONE provider key below (the agent needs a model to run), then pick
# the model with HERMES_PROVIDER / HERMES_MODEL further down.

# OpenRouter — 200+ models behind one key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (direct) — get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- Model selection (optional) ----
# Leave both empty to use the image's seeded default (anthropic/claude-opus-4.6 via OpenRouter).
#
# Pick a model by matching the provider key you set above:
#   • OpenRouter (default provider): set HERMES_MODEL to an OpenRouter id, e.g.
#       HERMES_MODEL=anthropic/claude-opus-4.6
#       HERMES_MODEL=nousresearch/hermes-4-405b
#       HERMES_MODEL=deepseek/deepseek-chat        # DeepSeek *via* OpenRouter (uses OPENROUTER_API_KEY)
#   • DeepSeek (direct, uses DEEPSEEK_API_KEY): set BOTH of these:
#       HERMES_PROVIDER=deepseek
#       HERMES_MODEL=deepseek-chat                 # or deepseek-reasoner
HERMES_PROVIDER=
HERMES_MODEL=
