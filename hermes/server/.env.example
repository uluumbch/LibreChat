# ---- Hermes-Chat BFF environment (running WITHOUT docker) ----
# Copy to server/.env:   cp server/.env.example server/.env
# (The docker stack sets these in docker-compose.yml — you only need this file
#  when running `npm run dev:server` directly on your host.)

# HTTP
PORT=8090
# Comma-separated origins allowed to call the BFF (the client dev server)
CORS_ORIGIN=http://localhost:5273

# Postgres (Prisma)
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes_chat?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- Hermes gateway pool ----
# The app owns the provider key; each gateway is a Hermes api_server exposed on its own port.
# Provide one JSON array describing the pool. `model` is the label users pick; it must match
# the model the gateway advertises at /v1/models (API_SERVER_MODEL_NAME, default `hermes-agent`).
# `apiKey` is the gateway's API_SERVER_KEY. Example with a single gateway:
HERMES_GATEWAYS=[{"id":"default","model":"hermes-agent","baseURL":"http://localhost:8642","apiKey":"change-me-local-dev"}]

# Default model assigned to a new user's hermes_profile (must be one of the pool models)
HERMES_DEFAULT_MODEL=hermes-agent
