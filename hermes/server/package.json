    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@hermes/shared": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
